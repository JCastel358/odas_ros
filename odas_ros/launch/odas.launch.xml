<launch>
  <!-- Arguments -->
  <arg name="configuration_path" default="$(find-pkg-share odas_ros)/config/odas_jetson_respeaker_sep.cfg"/>
  <arg name="frame_id" default="odas"/>
  <arg name="audio_queue_size" default="1"/>
  <arg name="visualization" default="true"/>
  <arg name="rviz" default="false"/>
  <arg name="rviz_cfg" default="-d $(find-pkg-share odas_ros)/config/rviz/odas_rviz.rviz"/>
  <arg name="local" default="true" />
  <arg name="force_publish_tf" default="false"/>
  <arg name="use_echo_cancellation" default="false"/>
  <arg name="echo_cancelled_signal_topic" default="ec_signal"/>
  <arg name="enable_leak_classifier" default="false"/>
  <arg name="leak_classifier_debug" default="false"/>
  <arg name="leak_classifier_params_file" default="$(find-pkg-share odas_ros)/config/leak_classifier_params.yaml"/>
  <arg name="doa_zero_offset_deg" default="39.0"/>
  <arg name="log_level" default="warn"/>

  <!-- ODAS -->
  <group>
    <node unless="$(var use_echo_cancellation)" pkg="odas_ros" exec="odas_server_node.py" name="odas_server_node" args="--ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error">
      <param name="configuration_path" value="$(var configuration_path)"/>
      <param name="frame_id" value="$(var frame_id)"/>
      <param name="audio_queue_size" value="$(var audio_queue_size)"/>
      <param name="core_log_level" value="$(var log_level)"/>
    </node>
    <node if="$(var use_echo_cancellation)" pkg="odas_ros" exec="odas_echocancel_filter_server_node.py" name="odas_server_node" args="--ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error">
      <param name="configuration_path" value="$(var configuration_path)"/>
      <param name="frame_id" value="$(var frame_id)"/>
      <param name="audio_queue_size" value="$(var audio_queue_size)"/>
      <param name="core_log_level" value="$(var log_level)"/>

      <remap from="ec_signal" to="$(var echo_cancelled_signal_topic)"/>
    </node>

    <node if="$(var enable_leak_classifier)" pkg="odas_ros" exec="odas_leak_classifier_node.py" name="odas_leak_classifier_node" args="--ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error">
      <param from="$(var leak_classifier_params_file)"/>
      <param name="publish_debug_logs" value="$(var leak_classifier_debug)"/>
      <param name="sst_topic" value="sst_raw"/>
      <param name="sss_topic" value="sss"/>
      <param name="leak_topic" value="/leak_detected"/>
      <param name="doa_topic" value="/doa_angle"/>
      <param name="doa_zero_offset_deg" value="$(var doa_zero_offset_deg)"/>
    </node>

    <group if="$(var visualization)">
      <node pkg="odas_ros" exec="odas_visualization_node.py" name="odas_visualization_node" args="--ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error">
        <param name="configuration_path" value="$(var configuration_path)"/>
      </node>

      <!-- Position of frame ODAS relative to robot Base_link (x y z yaw pitch roll).
           yaw=3.14159 (180 deg) = array re-mounted flipped from its old orientation.
           NOTE: this TF is RViz-only; leak bearing is oriented by doa_zero_offset_deg. -->
      <node if="$(or $(var rviz) $(var force_publish_tf))" pkg="tf2_ros" exec="static_transform_publisher" name="odas_broadcaster" args="0.10 0 0.21 3.14159 0 0 base_link $(var frame_id) --ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error" />

      <!--Run Rviz-->
      <node if="$(var rviz)" name="rviz" pkg="rviz2" exec="rviz2" args="-d $(var rviz_cfg) --ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error"/>
    </group>
    <group unless="$(var visualization)">
      <!-- Position of frame ODAS relative to robot Base_link (x y z yaw pitch roll).
           yaw=3.14159 (180 deg) = array re-mounted flipped from its old orientation.
           NOTE: this TF is RViz-only; leak bearing is oriented by doa_zero_offset_deg. -->
      <node if="$(var force_publish_tf)" pkg="tf2_ros" exec="static_transform_publisher" name="odas_broadcaster" args="0.10 0 0.21 3.14159 0 0 base_link $(var frame_id) --ros-args --log-level $(var log_level) --log-level rmw_cyclonedds_cpp:=error" />
    </group>
  </group>
</launch>
